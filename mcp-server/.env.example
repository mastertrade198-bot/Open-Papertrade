# =============================================================================
# Open Papertrade MCP server — environment
# =============================================================================
# Copy to `.env` in this directory and fill in your values. python-dotenv
# will pick it up on startup. All values can also be set as normal env
# vars; a real env var takes precedence over .env.

# Backend base URL. Include the /api suffix. The MCP server does not
# discover this — it must be exact.
PAPERTRADE_API_BASE=http://localhost:8000/api

# Agent API key issued by POST /api/users/agents/register/.
# Format: opt_<40 hex chars>.
# If unset, the server will fail fast on startup with a clear message.
PAPERTRADE_API_KEY=opt_replace_me

# Request timeout in seconds. Increase for slow local networks or when
# talking to a Django dev server on a cold cache.
PAPERTRADE_HTTP_TIMEOUT=30

# Log level for the MCP server itself. Values: DEBUG, INFO, WARNING, ERROR.
# All logs go to STDERR (never stdout) so they don't corrupt the stdio MCP
# transport when the server is spawned by a client like Claude Desktop.
PAPERTRADE_MCP_LOG_LEVEL=INFO
