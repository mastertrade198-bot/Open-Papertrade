# =============================================================================
# Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ---- Django Settings ----
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Stock Data Provider ----
# Finnhub API key (get a free key at https://finnhub.io/)
# Falls back to Yahoo Finance if not set
FINNHUB_API_KEY=your_finnhub_api_key_here

# ---- Supabase (required when DEBUG=False) ----
# 1. Create a project at https://supabase.com
# 2. Get the PostgreSQL connection string from Project Settings > Database
# 3. Get the service role key from Project Settings > API
# 4. Create a public storage bucket named "avatars"
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars

# =============================================================================
# LLM provider (used by AI Trade Coach and Filings Research Analyst)
# =============================================================================
# SEC EDGAR requires a descriptive User-Agent identifying you.
SEC_EDGAR_USER_AGENT=Open-Papertrade Research (your-email@example.com)

# Which provider to use.
# One of: anthropic | openai | openrouter | mistral | ollama | local
LLM_PROVIDER=openrouter

# Optional model override. If set, this wins over each provider's built-in default.
# Provider-specific overrides also work: ANTHROPIC_MODEL, OPENAI_MODEL,
# OPENROUTER_MODEL, MISTRAL_MODEL, OLLAMA_MODEL, LOCAL_MODEL.
# LLM_MODEL=

# --- Anthropic (Claude) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (GPT) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- OpenRouter (recommended — one key for Claude, GPT, Mistral, Llama, Gemini, …) ---
# https://openrouter.ai/keys — free tier available on some models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Free alternatives:
#   OPENROUTER_MODEL=meta-llama/llama-4-maverick:free
#   OPENROUTER_MODEL=google/gemma-3-1b-it:free
# Optional attribution (shows on OpenRouter's public leaderboard):
OPENROUTER_REFERER=https://open-papertrade.local
OPENROUTER_APP_TITLE=Open-Papertrade Filings

# --- Mistral ---
# https://console.mistral.ai/
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# --- Local runners (OpenAI-compatible endpoints, no API key required) ---
# Ollama (default http://localhost:11434 — pull a model with `ollama pull llama3.1`)
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# LM Studio / vLLM / llama.cpp server: set this to whichever you're running.
#   LM Studio       -> http://localhost:1234/v1
#   vLLM            -> http://localhost:8000/v1
#   llama.cpp server-> http://localhost:8080/v1
LOCAL_LLM_BASE_URL=
# LOCAL_MODEL=local-model

# Embedding + chunking config (safe to leave default).
FILINGS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FILINGS_CHUNK_TOKENS=400
FILINGS_CHUNK_OVERLAP=50


# =============================================================================
# Filings Research — LangGraph ReAct agent
# =============================================================================
# The /api/filings/ask/ endpoint accepts { "agent": true } to route the
# question through a LangGraph ReAct agent that can call multiple tools:
#   - search_filing:      grounded query over the ingested corpus
#   - list_filings:       enumerate a company's filings
#   - get_filing_metadata: read one filing's metadata
#
# The agent uses the same LLM_PROVIDER + <PROVIDER>_MODEL config as the
# non-agent path. Provider selection is preserved end-to-end.

# Hard cap on ReAct loop iterations. Guards against a stuck loop (misbehaving
# model, broken tool) burning tokens indefinitely. Raise for complex multi-hop
# research; lower for strict latency budgets. Each iteration = 1 LLM call.
FILINGS_AGENT_MAX_ITERATIONS=12

# --- Agent + tool-calling compatibility notes ---
# Not every model supports tool-calling well. If you set LLM_PROVIDER to an
# option below and the agent behaves oddly (loops without tool calls,
# malformed arguments, refuses to use tools), swap to one of the "known
# reliable" models on the same provider.
#
# Provider           Known reliable model                     Notes
# ─────────────────  ───────────────────────────────────────  ─────────────────
# anthropic          claude-3-5-sonnet-20241022               Best tool use.
# openai             gpt-4o, gpt-4o-mini                      Very reliable.
# openrouter         anthropic/claude-3.5-sonnet              Free tier models
#                                                             often too small.
# mistral            mistral-large-latest                     Small models
#                                                             lack tools.
# ollama             llama3.1, llama3.2, qwen2.5              Llama 3.0 and
#                                                             earlier: no tools.
# local              depends on the model you serve           Verify the model
#                                                             emits OpenAI-
#                                                             compatible tool
#                                                             call responses.


# =============================================================================
# LangSmith tracing (optional)
# =============================================================================
# When LANGSMITH_API_KEY is set, LangChain automatically pushes a trace of
# every agent LLM call, tool invocation, and state transition to
# https://smith.langchain.com under LANGSMITH_PROJECT.
#
# What gets traced:
#   - the full ReAct message history for each request
#   - each tool call's inputs and outputs
#   - each LLM call's messages, tools, output tokens, latency, cost
#
# What is NOT sent:
#   - your Django database, user data, or portfolio contents
#   - the raw filing corpus (only excerpts that pass through tool responses)
#
# LangSmith requires network access and phones home to LangChain's servers.
# Leave everything below unset for fully-offline / privacy-sensitive
# deployments — the agent works without tracing.
#
# Sign up + create a project at https://smith.langchain.com

# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=open-papertrade-filings
# LANGSMITH_TRACING=true
